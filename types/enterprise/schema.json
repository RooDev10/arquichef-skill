{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arquichef/types/enterprise/schema.json",
  "title": "ArquiChef enterprise architecture map (spec format 2)",
  "description": "A one-sheet layered enterprise architecture with a fixed canonical layout: top bands (actors, strategy, capabilities), side narratives (demand, value), stacked layers (business, application, data, technology) with named slots, and optional cross-cutting lateral layers. No connectors: containment and position carry the meaning. The spec says WHAT goes in each slot; the renderer decides WHERE and HOW it is drawn.",
  "type": "object",
  "additionalProperties": false,
  "required": ["arquichef", "type", "meta", "layers"],
  "properties": {
    "arquichef": { "const": "2", "description": "Spec format version. Format 1 specs can be converted with `arquichef migrate`." },
    "type": { "const": "enterprise" },
    "meta": { "$ref": "#/$defs/meta" },
    "actors": { "$ref": "#/$defs/actors" },
    "strategy": { "$ref": "#/$defs/strategy" },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "demand": { "$ref": "#/$defs/narrative" },
    "value": { "$ref": "#/$defs/narrative" },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business", "application", "technology"],
      "properties": {
        "business": { "$ref": "#/$defs/business" },
        "application": { "$ref": "#/$defs/application" },
        "data": { "$ref": "#/$defs/data" },
        "technology": { "$ref": "#/$defs/technology" }
      }
    },
    "laterals": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/lateral" } },
    "notes": {
      "description": "Findings for the reader of the README, e.g. inconsistencies found in the source document.",
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "organization", "sources"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "organization": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 800 },
        "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "width": { "type": "integer", "minimum": 1600, "maximum": 3600 },
        "footer": { "type": "string", "maxLength": 200 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          }
        }
      }
    },
    "icon": {
      "enum": ["actor", "goal", "capability", "service", "process", "function", "component", "interface", "data", "node", "device", "principle", "framework", "location", "value", "chain", "risk"]
    },
    "source": {
      "description": "Where the element comes from: a meta.sources id, optionally followed by ':' and a section, e.g. 'report:4.1.4'.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}(:[A-Za-z0-9 ._()+,/-]{1,40})?$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": { "type": "string", "maxLength": 1200, "description": "Plain-language explanation of the band for the README." },
    "columns": { "type": "integer", "minimum": 1, "maximum": 8 },
    "weights": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "number", "minimum": 0.2, "maximum": 12 } },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 70 },
        "detail": { "type": "string", "maxLength": 110 },
        "tag": { "type": "string", "maxLength": 20 },
        "icon": { "$ref": "#/$defs/icon", "description": "Overrides the slot's default icon. Set it only when the element is of a different kind." },
        "variant": { "enum": ["dashed", "rounded", "emphasis", "plain", "compact"], "description": "Overrides the slot's default look. Usually only 'compact' for long identifiers." },
        "source": { "$ref": "#/$defs/source" },
        "inferred": { "type": "boolean", "description": "true when the element is a reasonable inference, not stated in the source." }
      }
    },
    "elements": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/element" } },
    "section": {
      "description": "A titled container of elements in a fixed slot. The title defaults to the canonical heading of the slot in meta.language.",
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "title": { "$ref": "#/$defs/title" },
        "note": { "type": "string", "maxLength": 90 },
        "columns": { "$ref": "#/$defs/columns" },
        "items": { "$ref": "#/$defs/elements" }
      }
    },
    "actors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "groups"],
      "properties": {
        "title": { "$ref": "#/$defs/title" },
        "summary": { "$ref": "#/$defs/summary" },
        "weights": { "$ref": "#/$defs/weights" },
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "items"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 90 },
              "items": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/element" } }
            }
          }
        }
      }
    },
    "strategy": {
      "description": "Three columns: statements (mission, vision) on the left; goals, then business model elements, fill the other two columns top to bottom.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "statements", "goals"],
      "properties": {
        "title": { "$ref": "#/$defs/title" },
        "summary": { "$ref": "#/$defs/summary" },
        "statements": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/element" } },
        "goals": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/element" } },
        "model": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/element" } }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {
        "title": { "$ref": "#/$defs/title" },
        "summary": { "$ref": "#/$defs/summary" },
        "columns": { "$ref": "#/$defs/columns" },
        "items": { "type": "array", "minItems": 1, "maxItems": 28, "items": { "$ref": "#/$defs/element" } }
      }
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "paragraphs"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 40 },
        "paragraphs": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 320 } },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "business": {
      "description": "Canonical business layer. Top: frameworks row. Below, four columns: knowledge | change | (organization, services, processes stacked) | data governance.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "frameworks", "knowledge", "change", "organization", "services", "processes", "dataGovernance"],
      "properties": {
        "title": { "$ref": "#/$defs/title" },
        "summary": { "$ref": "#/$defs/summary" },
        "frameworks": { "$ref": "#/$defs/section" },
        "knowledge": { "$ref": "#/$defs/section" },
        "change": { "$ref": "#/$defs/section" },
        "organization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["units"],
          "properties": {
            "title": { "$ref": "#/$defs/title" },
            "weights": { "$ref": "#/$defs/weights" },
            "units": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/section" } }
          }
        },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "required": ["external", "internal"],
          "properties": {
            "title": { "$ref": "#/$defs/title" },
            "weights": { "$ref": "#/$defs/weights" },
            "external": { "$ref": "#/$defs/section" },
            "internal": { "$ref": "#/$defs/section" }
          }
        },
        "processes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stages"],
          "properties": {
            "title": { "$ref": "#/$defs/title" },
            "stages": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/element" } },
            "crossCutting": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/element" } }
          }
        },
        "dataGovernance": { "$ref": "#/$defs/section" }
      }
    },
    "application": {
      "description": "Canonical application layer: core system (wide) | client apps | IT services | third parties (| legacy).",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "core", "clients", "itServices", "thirdParty"],
      "properties": {
        "title": { "$ref": "#/$defs/title" },
        "summary": { "$ref": "#/$defs/summary" },
        "core": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "items"],
          "properties": {
            "title": { "$ref": "#/$defs/title" },
            "note": { "type": "string", "maxLength": 90, "description": "Technology or style, shown after the title." },
            "columns": { "$ref": "#/$defs/columns" },
            "items": { "$ref": "#/$defs/elements" },
            "jobs": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/element" }, "description": "Background or scheduled processes, shown in a row under the modules." }
          }
        },
        "clients": { "$ref": "#/$defs/section" },
        "itServices": { "$ref": "#/$defs/section" },
        "thirdParty": { "$ref": "#/$defs/section" },
        "legacy": { "$ref": "#/$defs/section" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {
        "title": { "$ref": "#/$defs/title" },
        "summary": { "$ref": "#/$defs/summary" },
        "columns": { "$ref": "#/$defs/columns" },
        "items": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/element" } },
        "governance": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/element" }, "description": "Key data rules (isolation, retention, privacy), shown last with the principle icon." }
      }
    },
    "technology": {
      "description": "Canonical technology layer: nodes row on top, risk and security strips under it, technology governance column on the right.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "nodes", "risks", "security", "governance"],
      "properties": {
        "title": { "$ref": "#/$defs/title" },
        "summary": { "$ref": "#/$defs/summary" },
        "columns": { "$ref": "#/$defs/columns" },
        "nodes": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/element" } },
        "risks": { "$ref": "#/$defs/section" },
        "security": { "$ref": "#/$defs/section" },
        "governance": { "$ref": "#/$defs/section" }
      }
    },
    "lateral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "sections"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "summary": { "$ref": "#/$defs/summary" },
        "icon": { "$ref": "#/$defs/icon" },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "business": { "$ref": "#/$defs/section" },
            "application": { "$ref": "#/$defs/section" },
            "data": { "$ref": "#/$defs/section" },
            "technology": { "$ref": "#/$defs/section" }
          }
        }
      }
    }
  }
}
